# Copy to .env.local for local work. Set real values in Vercel for deployments.
# Never commit a populated environment file or paste private keys in a chat.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. This must never have a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# Exact public origin, with no path. Use the stable production/custom domain.
APP_URL=https://YOUR_APP.vercel.app

# Older Supabase projects can use these aliases instead of the two keys above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
